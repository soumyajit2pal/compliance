APP_ENV=prod
DATABASE_URL=oracle+oracledb://compliance_portal:REPLACE_WITH_PROD_PASSWORD@REPLACE_WITH_PROD_HOST:1521/?service_name=REPLACE_WITH_PROD_SERVICE
# Required for the consolidated foundation migration: 12+ characters, different from the UAT default.
SEED_USER_PASSWORD=
# Mandatory: a different, DBA-provisioned restricted runtime account.
RUNTIME_DATABASE_URL=oracle+oracledb://REPLACE_RUNTIME_USER:REPLACE_WITH_RUNTIME_PASSWORD@REPLACE_WITH_PROD_HOST:1521/?service_name=REPLACE_WITH_PROD_SERVICE
SECRET_KEY=
# Required: deployment-owned RSA 3072+ bit PKCS8 PEM, owner-only permissions.
# Generate a distinct key for Prod; mount read-only for all API workers.
LOGIN_ENCRYPTION_PRIVATE_KEY_FILE=/REPLACE_WITH_APPROVED_PRIVATE_KEY_STORE/login-private.pem
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_APPROVED_PORTAL_HOST
SESSION_COOKIE_SECURE=true
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=30
UPLOAD_STORAGE_ROOT=/REPLACE_WITH_APPROVED_PERSISTENT_DOCUMENT_STORE
# Separate persistent mount, outside the upload root. POSIX flock required.
LOG_DIR=/REPLACE_WITH_APPROVED_PERSISTENT_LOG_STORE
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DEEP_LOGGING=false
SLOW_REQUEST_MS=2000
# LDAP_SERVER_URI=ldaps://REPLACE_WITH_DIRECTORY_HOST:636
# LDAP_BASE_DN=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_CA_CERT_FILE=/approved/server/path/bank-root-ca.pem

# QA Portal-style LDAP administration (database settings override bootstrap values).
# LDAP_ENABLED=true
# LDAP_USE_SSL=true
# LDAP_START_TLS=true
# LDAP_ATTR_FULL_NAME=displayName
# LDAP_ATTR_EMAIL=mail
# The bank LDAP department attribute returns the department code.
LDAP_ATTR_DEPARTMENT_CODE=department
# Prod startup refuses mock LDAP if this is set to true.
LDAP_MOCK_ENABLED=false
