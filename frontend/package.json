{
  "name": "compliance-portal-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node ../scripts/sync_frontend_public.mjs && vite build",
    "check": "npm run typecheck",
    "test:editions": "node --test tests/source-editions.test.mjs tests/clause-scope.test.mjs tests/clause-navigation.test.mjs",
    "test:clauses": "node tests/clause-workspace.browser.cjs",
    "test:clauses:live": "node tests/clause-workspace.live.cjs",
    "test:families": "node tests/notification-families.browser.cjs",
    "test:family-filters:live": "node tests/notification-family-filters.live.cjs",
    "test:repository-filters:live": "node tests/repository-filters.live.cjs",
    "test:login-encryption:live": "node tests/login-encryption.live.cjs",
    "test:login-bootstrap": "node tests/login-bootstrap.browser.cjs",
    "test:loading": "node tests/loading.browser.cjs",
    "test:searchable-selects:live": "node tests/searchable-selects.live.cjs",
    "test:ldap-department": "node tests/ldap-department.browser.cjs",
    "test:ldap-readiness": "node --test tests/ldap-readiness.test.mjs",
    "test:ldap-accounts": "node tests/ldap-accounts.browser.cjs",
    "test:masters": "node tests/master-maintenance.browser.cjs",
    "test:masters:live": "node tests/master-maintenance.live.cjs",
    "test:imports": "node tests/combined-import.browser.cjs",
    "test:imports:live": "node tests/combined-import.live.cjs",
    "test:https:live": "node tests/local-https.live.cjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
