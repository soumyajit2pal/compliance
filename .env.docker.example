APP_ENV=uat
# The one-time migration job uses this Oracle owner profile by default.
# Set PORTAL_MIGRATION_ENV_FILE in the Compose environment to select a separate owner profile.
# Use the reachable Oracle listener. On Docker Desktop, this address reaches the host.
DATABASE_URL=oracle+oracledb://compliance_portal:REPLACE_WITH_UAT_PASSWORD@host.docker.internal:1523/?service_name=FREEPDB1
# Set a deployment-specific value of at least 48 random characters.
SECRET_KEY=
CORS_ALLOWED_ORIGINS=https://localhost:8010,https://127.0.0.1:8010
UAT_DEMO_LOGIN_ENABLED=true
# Enable only on the deployment that is responsible for reminders.
COMPLIANCE_REMINDERS_ENABLED=false
