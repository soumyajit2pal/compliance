APP_ENV=uat
DATABASE_URL=oracle+oracledb://compliance_portal:REPLACE_WITH_UAT_PASSWORD@localhost:1523/?service_name=FREEPDB1
# Optional override for new role-user passwords. Default matches QA: Password@123.
# SEED_USER_PASSWORD=replace-with-a-temporary-password
# Portal/API on https://localhost:8010 after local_https setup. A restricted runtime account is recommended.
# RUNTIME_DATABASE_URL=oracle+oracledb://runtime_user:REPLACE@localhost:1523/?service_name=FREEPDB1
# SECRET_KEY=generate-at-least-48-random-characters
# Provision once: .venv/bin/python -m backend.app.generate_login_key var/login-private.pem
LOGIN_ENCRYPTION_PRIVATE_KEY_FILE=var/login-private.pem
CORS_ALLOWED_ORIGINS=https://127.0.0.1:8010,https://localhost:8010
SESSION_COOKIE_SECURE=true
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=30
# UAT-only selector for seed accounts still using the original demo password.
# Never enabled in Prod. Set false when UAT no longer needs public demo access.
UAT_DEMO_LOGIN_ENABLED=true
# Relative UAT paths resolve from this project, never the working directory.
# Documents remain at <root>/<id>; import files use <root>/staging/<id>.
UPLOAD_STORAGE_ROOT=var/documents
LOG_DIR=var/logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DEEP_LOGGING=false
SLOW_REQUEST_MS=2000
# Directory values bootstrap configuration until Admin saves LDAP settings.
# LDAP_SERVER_URI=ldaps://directory.bank.example:636
# LDAP_BASE_DN=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=bank,dc=example
# LDAP_CA_CERT_FILE=/approved/server/path/bank-root-ca.pem

# QA Portal-style LDAP administration (database settings override bootstrap values).
# LDAP_ENABLED=true
# LDAP_USE_SSL=true
# LDAP_START_TLS=true
# LDAP_ATTR_FULL_NAME=displayName
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_DEPARTMENT=department
# Required bank-confirmed code attribute; blank restricts real LDAP workspace access.
# LDAP_ATTR_DEPARTMENT_CODE=
# LDAP_ATTR_DEPARTMENT_NAME=department
# UAT-only demo: real onboarding without a directory server.
LDAP_MOCK_ENABLED=false
LDAP_MOCK_USERNAME_PREFIX=bmock
# Public QA Portal demo password. Set your preferred UAT demo password before enabling.
# LDAP_MOCK_PASSWORD=QualityOps-Mock-LDAP-2026!

# Local UAT only; generate once with .venv/bin/python -m backend.app.local_https setup
TLS_CERT_FILE=var/tls/localhost.crt
TLS_KEY_FILE=var/tls/localhost.key
UAT_HTTPS_HOST=127.0.0.1
UAT_HTTPS_PORT=8010
